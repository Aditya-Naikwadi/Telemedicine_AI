{
  "name": "telemed-ai-agent",
  "version": "1.0.0",
  "description": "Production-ready AI agent package for telemedicine applications with built-in medical knowledge, HIPAA compliance, and intelligent patient assistance",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "keywords": [
    "telemedicine",
    "healthcare",
    "ai-agent",
    "medical-assistant",
    "symptom-assessment",
    "appointment-scheduling",
    "hipaa",
    "openai",
    "llm",
    "healthcare-ai"
  ],
  "author": "TeleMedicine AI Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/telemed/telemed-ai-agent"
  },
  "bugs": {
    "url": "https://github.com/telemed/telemed-ai-agent/issues"
  },
  "homepage": "https://github.com/telemed/telemed-ai-agent#readme",
  "dependencies": {
    "date-fns": "^2.30.0",
    "openai": "^4.104.0",
    "uuid": "^9.0.1",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jest": "^29.5.10",
    "@types/node": "^20.19.27",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}